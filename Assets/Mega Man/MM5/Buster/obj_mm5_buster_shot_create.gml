// Objects > Mega Man > MM5 > Buster > obj_mm5_buster_shot > Create.
// The firing code will set shot_direction to +1 or -1 after creation.
shot_direction = 1;
shot_speed = 1075 / 256;

// Manual movement only; don't also use built-in speed/hspeed.
speed = 0;
gravity = 0;
image_speed = 0;
image_index = 0;
image_xscale = 1;
image_yscale = 1;
depth = -11;
